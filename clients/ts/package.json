{
  "name": "lobbylink-client",
  "version": "0.1.0",
  "description": "Zero-dependency browser client for the lobbylink P2P lobby + WebRTC DataChannel system",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p . && node -e \"require('fs').copyFileSync('dist/index.js','../../web/p2p-client.js')\"",
    "check": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
